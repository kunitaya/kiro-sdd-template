#!/bin/sh
# Generic helper for the mechanical archive step only.
# PR Ready transition is intentionally left to the repository's GitHub tooling/operator.
set -eu

spec=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --spec) spec=${2:-}; shift 2 ;;
    --check) check=1; shift ;;
    *) echo "usage: ./scripts/finalize-spec --spec <issue-number>-<slug> [--check]" >&2; exit 64 ;;
  esac
done
[ -n "$spec" ] || { echo "--spec is required" >&2; exit 64; }
root=$(git rev-parse --show-toplevel)
cd "$root"
[ "$(git branch --show-current)" != "main" ] || { echo "refusing finalization on main" >&2; exit 1; }
src=".kiro/specs/$spec"
dst="docs/spec-archive/$spec"
[ -d "$src" ] || { echo "active spec not found: $src" >&2; exit 1; }
[ ! -e "$dst" ] || { echo "archive destination already exists: $dst" >&2; exit 1; }
if [ "${check:-0}" = 1 ]; then echo "FINALIZE_SPEC_READY"; exit 0; fi
mkdir -p docs/spec-archive
mv "$src" "$dst"
echo "Spec archived to $dst. Inspect diff/status, commit/push, then transition the existing Draft PR to Ready after required review gates are satisfied."
